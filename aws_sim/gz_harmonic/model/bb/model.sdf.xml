<?xml version="1.0" ?>
  <sdf version="1.6">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <model name='bb'>
      <pose>0 0 0.325 0 0 0</pose>
        <!-- ////////////////////////////-->
        <!-- ////////////////////////////-->
        <!-- BASE LINK -->
        <!-- ////////////////////////////-->
        <!-- ////////////////////////////-->
      <link name='base_link'>
        <pose>0 0 0 0 0 1.57</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.126164</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.416519</iyy>
            <iyz>0</iyz>
            <izz>0.481014</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
                <geometry>
                    <mesh>
                        <scale>0.001 0.001 0.001</scale>
                        <uri>meshes/base_link.stl</uri>
                    </mesh>
                </geometry>
          <material>
            <ambient>0.5 0.5 1.0 1</ambient>
            <diffuse>0.5 0.5 1.0 1</diffuse>
            <specular>0.0 0.0 1.0 1</specular>
          </material>
        </visual>
        <collision name='collision'>
                <geometry>
                    <mesh>
                        <scale>0.001 0.001 0.001</scale>
                        <uri>meshes/base_link.stl</uri>
                    </mesh>
                </geometry>
        </collision>
        <sensor name="navsat" type="navsat">
            <gz_frame_id>camera_link</gz_frame_id>
            <always_on>1</always_on>
            <update_rate>1</update_rate>
            <topic>gps/fix</topic>
        </sensor>
        <sensor name="imu_sensor" type="imu">
            <gz_frame_id>base_link</gz_frame_id>
            <always_on>1</always_on>
            <update_rate>1</update_rate>
            <visualize>true</visualize>
            <topic>imu</topic>
        </sensor>
      </link>
        <!-- ////////////////////////////-->
        <!-- ////////////////////////////-->
        <!-- LIDAR LINK -->
        <!-- ////////////////////////////-->
        <!-- ////////////////////////////-->
        <link name='lidar_link'>
            <pose relative_to='base_link'>0 0 0.14 0 0 -1.57</pose>
            <inertial>
                <mass>0.1</mass>
                <inertia>
                    <ixx>0.126164</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.416519</iyy>
                    <iyz>0</iyz>
                    <izz>0.481014</izz>
                </inertia>
            </inertial>
            <visual name='visual'>
                <geometry>
                    <mesh>
                        <scale>0.001 0.001 0.001</scale>
                        <uri>meshes/lidar.stl</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0.2 0.2 0.2 1</ambient>
                    <diffuse>0.2 0.2 0.2 1</diffuse>
                    <specular>0.2 0.2 0.2 1</specular>
                </material>
            </visual>
            <collision name='collision'>
                <geometry>
                    <mesh>
                        <scale>0.001 0.001 0.001</scale>
                        <uri>meshes/lidar.stl</uri>
                    </mesh>
                </geometry>
            </collision>

           <sensor name='gpu_lidar' type='gpu_lidar'>"
                <gz_frame_id>lidar_link</gz_frame_id>
                <pose relative_to='lidar_link'>0 0 0 0 0 0</pose>
                <topic>/scan</topic>
                <update_rate>1</update_rate>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>320</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.14</min_angle>
                            <max_angle>3.14</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>32</samples>
                            <resolution>1</resolution>
                            <min_angle>-0.261791667</min_angle>
                            <max_angle>0.261791667</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.6</min>
                        <max>32.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </ray>
                <always_on>1</always_on>
                <visualize>true</visualize>
           </sensor>
        </link>

        <joint name='lidar_joint' type='fixed'>
           <pose relative_to='base_link'>0 0 0.14 0 0 0</pose>
            <parent>base_link</parent>
            <child>lidar_link</child>
        </joint>

      <link name='left_wheel'>
        <pose>0 0.15 0 -1.57 0 0</pose>
        <inertial>
          <mass>2</mass>
          <inertia>
            <ixx>0.145833</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.145833</iyy>
            <iyz>0</iyz>
            <izz>0.125</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
                <geometry>
                    <mesh>
                        <scale>0.001 0.001 0.001</scale>
                        <uri>meshes/wheel.stl</uri>
                    </mesh>
                </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name='collision'>
                <geometry>
                    <mesh>
                        <scale>0.001 0.001 0.001</scale>
                        <uri>meshes/wheel.stl</uri>
                    </mesh>
                </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
                <slip1>0.035</slip1>
                <slip2>0</slip2>
                <fdir1>0 0 1</fdir1>
              </ode>
              <bullet>
                <friction>1</friction>
                <friction2>1</friction2>
                <rolling_friction>0.1</rolling_friction>
              </bullet>
            </friction>
          </surface>
        </collision>
      </link>
      <joint name='left_wheel_joint' type='revolute'>
        <parent>base_link</parent>
        <child>left_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>

      <link name='right_wheel'>
        <pose>0 -0.18 0 -1.57 0 0</pose>
        <inertial>
          <mass>2</mass>
          <inertia>
            <ixx>0.145833</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.145833</iyy>
            <iyz>0</iyz>
            <izz>0.125</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
                <geometry>
                    <mesh>
                        <scale>0.001 0.001 0.001</scale>
                        <uri>meshes/wheel.stl</uri>
                    </mesh>
                </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name='collision'>
                <geometry>
                    <mesh>
                        <scale>0.001 0.001 0.001</scale>
                        <uri>meshes/wheel.stl</uri>
                    </mesh>
                </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
                <slip1>0.035</slip1>
                <slip2>0</slip2>
                <fdir1>0 0 1</fdir1>
              </ode>
              <bullet>
                <friction>1</friction>
                <friction2>1</friction2>
                <rolling_friction>0.1</rolling_friction>
              </bullet>
            </friction>
          </surface>
        </collision>
      </link>

      <joint name='right_wheel_joint' type='revolute'>
        <parent>base_link</parent>
        <child>right_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>

        <link name='arm_1'>
            <pose>-0.1 0 0.245 0 0 0</pose>
            <inertial>
              <mass>0.1</mass>
              <inertia>
                <ixx>0.145833</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>0.145833</iyy>
                <iyz>0</iyz>
                <izz>0.125</izz>
              </inertia>
            </inertial>
            <visual name='visual'>
                    <geometry>
                        <mesh>
                            <scale>0.001 0.001 0.001</scale>
                            <uri>meshes/arm_1.stl</uri>
                        </mesh>
                    </geometry>
              <material>
                <ambient>0.2 0.2 0.2 1</ambient>
                <diffuse>0.2 0.2 0.2 1</diffuse>
                <specular>0.2 0.2 0.2 1</specular>
              </material>
            </visual>
            <collision name='collision'>
                    <geometry>
                        <mesh>
                            <scale>0.001 0.001 0.001</scale>
                            <uri>meshes/arm_1.stl</uri>
                        </mesh>
                    </geometry>
            </collision>
          </link>

        <joint name='arm_1_joint' type='revolute'>
                   <pose relative_to='base_link'>0 0.1 0.245 0 0 0</pose>
                    <parent>base_link</parent>
                    <child>arm_1</child>
                    <axis>
                        <xyz>0 0 1</xyz>
                        <limit>
                            <lower>-1.79769e+308</lower>
                            <upper>1.79769e+308</upper>
                            <velocity>1.</velocity>
                            <effort>1.79769e+308</effort>
                        </limit>

                    </axis>
                </joint>


        <link name='arm_2'>
            <pose>0.02 -0.022 0.28 -1.57 3.14 1.57</pose>
            <inertial>
              <mass>0.1</mass>
              <inertia>
                <ixx>0.145833</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>0.145833</iyy>
                <iyz>0</iyz>
                <izz>0.125</izz>
              </inertia>
            </inertial>
            <visual name='visual'>
                    <geometry>
                        <mesh>
                            <scale>0.001 0.001 0.001</scale>
                            <uri>meshes/arm_2.stl</uri>
                        </mesh>
                    </geometry>
              <material>
                <ambient>0.2 0.2 0.2 1</ambient>
                <diffuse>0.2 0.2 0.2 1</diffuse>
                <specular>0.2 0.2 0.2 1</specular>
              </material>
            </visual>
            <collision name='collision'>
                    <geometry>
                        <mesh>
                            <scale>0.001 0.001 0.001</scale>
                            <uri>meshes/arm_1.stl</uri>
                        </mesh>
                    </geometry>
            </collision>
          </link>

                <joint name='arm_2_joint' type='revolute'>
                   <pose relative_to='arm_1'>0 0 0.01 0 0 0</pose>
                    <parent>arm_1</parent>
                    <child>arm_2</child>
                    <axis>
                        <xyz>0 1 0</xyz>
                        <limit>
                            <lower>-1.57</lower>
                            <upper>0.00</upper>
                            <velocity>1.0</velocity>
                            <effort>1.79769e+308</effort>
                        </limit>

                    </axis>
                </joint>

        <!-- ////////////////////////////-->
        <!-- ////////////////////////////-->
        <!-- CAMERA LINK -->
        <!-- ////////////////////////////-->
        <!-- ////////////////////////////-->
        <link name='camera_link'>
            <pose relative_to='arm_2'>-0.025 0 -0.0 3.14 0 0</pose>
            <inertial>
                <mass>0.01</mass>
                <inertia>
                    <ixx>0.126164</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.416519</iyy>
                    <iyz>0</iyz>
                    <izz>0.481014</izz>
                </inertia>
            </inertial>
            <visual name='visual'>
                <geometry>
                    <mesh>
                        <scale>0.001 0.001 0.001</scale>
                        <uri>meshes/camera.stl</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0.6 0.6 0.6 1</ambient>
                    <diffuse>0.6 0.6 0.6 1</diffuse>
                    <specular>0.6 0.6 0.6 1</specular>
                </material>
            </visual>
            <collision name='collision'>
                <geometry>
                    <mesh>
                        <scale>0.001 0.001 0.001</scale>
                        <uri>meshes/camera.stl</uri>
                    </mesh>
                </geometry>
            </collision>

            <sensor name="depth" type="depth_camera">
              <pose relative_to='camera_link'>0 0 0 0 -1.57 1.57</pose>
              <gz_frame_id>camera_link</gz_frame_id>
              <update_rate>10</update_rate>
              <topic>camera/depth</topic>
              <camera>
                <horizontal_fov>1.05</horizontal_fov>
                <image>
                  <width>1280</width>
                  <height>720</height>
                  <format>R_FLOAT32</format>
                </image>
                <clip>
                  <near>0.01</near>
                  <far>32.0</far>
                </clip>
              </camera>
           </sensor>
           <sensor name="rgb" type="camera">
               <pose relative_to='camera_link'>0 0 0 0 -1.57 1.57</pose>
              <gz_frame_id>camera_link</gz_frame_id>
              <topic>camera/color</topic>
              <camera>
                <horizontal_fov>1.05</horizontal_fov>
                <image>
                  <width>1280</width>
                  <height>720</height>
                </image>
                <clip>
                  <near>0.1</near>
                  <far>100</far>
                </clip>
              </camera>
              <always_on>1</always_on>
              <update_rate>30</update_rate>
              <visualize>true</visualize>
           </sensor>
        </link>

        <joint name='camera_joint' type='fixed'>
            <parent>arm_2</parent>
            <child>camera_link</child>
        </joint>


      <link name='caster_wheel'>
            <pose>-0.2 0 -0.0575 0 0 0</pose>
            <inertial>
                <mass>1.1</mass>
                <inertia>
                    <ixx>0.016</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.016</iyy>
                    <iyz>0</iyz>
                    <izz>0.016</izz>
                </inertia>
            </inertial>
            <visual name='visual'>
                <geometry>
                    <sphere>
                        <radius>0.04</radius>
                    </sphere>
                </geometry>
                <material>
                    <ambient>0.2 0.2 0.2 1</ambient>
                    <diffuse>0.2 0.2 0.2 1</diffuse>
                    <specular>0.2 0.2 0.2 1</specular>
                </material>
            </visual>
            <collision name='collision'>
                <geometry>
                    <sphere>
                        <radius>0.04</radius>
                    </sphere>
                </geometry>
            </collision>
        </link>
        <joint name='caster_wheel_joint' type='ball'>
            <parent>base_link</parent>
            <child>caster_wheel</child>
        </joint>

        <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
            <joint_name>arm_1_joint</joint_name>
            <topic>/arm_1_joint</topic>
            <p_gain>5000</p_gain>
            <i_gain>0.0</i_gain>
            <d_gain>100.0</d_gain>
            <i_max>0</i_max>
            <i_min>-0</i_min>
            <cmd_max>100</cmd_max>
            <cmd_min>-100</cmd_min>

       </plugin>

        <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
            <joint_name>arm_2_joint</joint_name>
            <topic>/arm_2_joint</topic>
            <p_gain>5000</p_gain>
            <i_gain>0.0</i_gain>
            <d_gain>100.0</d_gain>
            <i_max>0</i_max>
            <i_min>-0</i_min>
            <cmd_max>100</cmd_max>
            <cmd_min>-100</cmd_min>

       </plugin>

      <plugin
        filename="libgz-sim-diff-drive-system.so"
        name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.33</wheel_separation>
        <wheel_radius>0.2</wheel_radius>
        <max_linear_acceleration>1</max_linear_acceleration>
        <min_linear_acceleration>-1</min_linear_acceleration>
        <max_angular_acceleration>2</max_angular_acceleration>
        <min_angular_acceleration>-2</min_angular_acceleration>
        <max_linear_velocity>6.0</max_linear_velocity>
        <min_linear_velocity>-6.5</min_linear_velocity>
        <max_angular_velocity>2</max_angular_velocity>
        <min_angular_velocity>-2</min_angular_velocity>
        <topic>cmd_vel</topic>
      </plugin>
       <!-- ////////////////////////////-->
       <!-- ////////////////////////////-->
       <!-- JOINT STATE PUBLISHER PLUGIN -->
       <!-- ////////////////////////////-->
       <!-- ////////////////////////////-->
       <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
           <joint_name>left_wheel_joint</joint_name>
           <joint_name>right_wheel_joint</joint_name>
           <joint_name>arm_1_joint</joint_name>
           <joint_name>arm_2_joint</joint_name>
           <topic>/joint_states</topic>
       </plugin>
        <!-- ////////////////////////////-->
        <!-- ////////////////////////////-->
        <!-- ODOMETRY PLUGIN -->
        <!-- ////////////////////////////-->
        <!-- ////////////////////////////-->
        <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
            <odom_frame>odom</odom_frame>
            <robot_base_frame>base_link</robot_base_frame>
            <odom_publish_frequency>30</odom_publish_frequency>
            <odom_topic>/odometry</odom_topic>
            <odom_covariance_topic>/odometry_with_covariance</odom_covariance_topic>
            <tf_topic>/tf</tf_topic>
            <dimensions>2</dimensions>
        </plugin>
        <!-- ////////////////////////////-->
       <!-- ////////////////////////////-->
       <!-- SENSORS PLUGIN -->
       <!-- ////////////////////////////-->
       <!-- ////////////////////////////-->
        <plugin filename="gz-sim-imu-system"
                name="gz::sim::systems::Imu">
        </plugin>
        <plugin filename="gz-sim-navsat-system"
                name="gz::sim::systems::NavSat">
        </plugin>
       <plugin
          filename="gz-sim-sensors-system"
          name="gz::sim::systems::Sensors">
          <render_engine>ogre2</render_engine>
       </plugin>
  </model>


</sdf>
